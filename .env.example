# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filled in after you connect Google once via /api/auth/start
GOOGLE_REFRESH_TOKEN=

# Your own secret. Long random string; the app and Shortcut send it to read your briefing.
BRIEFING_KEY=

# Optional: comma-separated calendar IDs (default: primary)
CALENDAR_IDS=primary

# Optional: IANA time zone override (default: your primary calendar's time zone)
TIME_ZONE=
